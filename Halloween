_func.RunNight = __xcall(function()
	local Root = _func.GetRoot()
	if not Root then return 0 end

	local houses = CollectionService:GetTagged("HouseSystemModel")
	local done = 0

	for _, House in ipairs(houses) do
		local houseName = House.Name
		Root = _func.GetRoot()
		if not Root then break end
		if not Module.DayNightService.CanTrickOrTreat() then break end
		if Module.HalloweenService.IsHouseOnCooldown(LocalPlayer, houseName) then continue end
		_func.WaitGlobalCooldown()
		local doorCFrame, prompt = _func.GetDoorData(House)
		if not doorCFrame or not prompt or not prompt.Enabled then continue end
		Root.CFrame = doorCFrame ; task.wait(0.45)
		if not _func.TriggerPrompt(prompt) then continue end
		lastKnockTime = Workspace:GetServerTimeNow() ; task.wait(3.5)
		if #_func.FindCandyCorns() > 0 then
			_func.WaitUntilCollected(6)
		end
		done += 1
		task.wait(0.7)
	end
	return done
end)

